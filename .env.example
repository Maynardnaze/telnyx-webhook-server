# Runtime config is managed in Doppler.
#
# Local dev:
#   doppler setup --project telnyx-webhook-server --config dev
#   doppler run -- docker compose up -d --build
#
# Production:
#   DOPPLER_TOKEN=$(cat /etc/doppler/telnyx-webhook-server.token) \
#     doppler run --project telnyx-webhook-server --config prd -- docker compose up -d --build
#
# Keep this file secret-free. Do not put WEBHOOK_SECRET, TELNYX_API_KEY,
# TELNYX_PUBLIC_KEY values, SMTP_PASSWORD, service tokens, or downloaded Doppler secret dumps here.
#
# Email report variables expected from Doppler/runtime env:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USERNAME=support@getmyswitch.com
#   SMTP_PASSWORD=<secret/app-password>
#   SMTP_FROM=support@getmyswitch.com
#   SMTP_STARTTLS=true
#   SMTP_USE_SSL=false
#   REPORT_EMAIL_TO=amaynard@example.com
